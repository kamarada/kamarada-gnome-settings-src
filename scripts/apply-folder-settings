#!/usr/bin/env bash

dconf load /org/gnome/desktop/app-folders/ < /usr/share/gnome-shell/app-folder-settings
#dconf load /org/gnome/shell/ < /usr/share/gnome-shell/app-grid-settings
[[ -e ~/.config/autostart/manjaro-app-folder-settings.desktop ]] && grep -q "Hidden=true" || echo "Hidden=true" >> ~/.config/autostart/manjaro-app-folder-settings.desktop
