#!/usr/bin/env bash

dconf load / < /usr/share/gnome-shell/extensions/material-shell@papyelgringo/schemas/org.gnome.shell.extensions.materialshell.gschema.override
dconf load /org/gnome/desktop/app-folders/ < /usr/share/gnome-shell/app-folder-settings
#dconf load /org/gnome/shell/ < /usr/share/gnome-shell/app-grid-settings
[[ -e ~/.config/autostart/manjaro-tiling-settings.desktop ]] && grep -q "Hidden=true" || echo "Hidden=true" >> ~/.config/autostart/manjaro-tiling-settings.desktop
