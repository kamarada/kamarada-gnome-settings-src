[org.freedesktop.Tracker.Extract]
sched-idle='always'

[org.freedesktop.Tracker.Miner.Files]
sched-idle='always'
index-on-battery=false

[org/gnome/desktop/app-folders]
folder-children=['accessories', 'office', 'system-tools']

[org/gnome/desktop/app-folders/folders/accessories]
apps=['yad-icon-browser.desktop', 'uget-gtk.desktop', 'transmission-gtk.desktop', 'org.gnome.Cheese.desktop']
categories=['Utility']
excluded-apps=['org.gnome.DejaDup.desktop', 'org.gnome.Nautilus.desktop', 'gnome-layouts.desktop', 'yelp.desktop', 'manjaro-documentation.desktop']
categories=['Utility']
name='Accessories'
translate=true

[org/gnome/desktop/app-folders/folders/office]
categories=['Office']
name='Office'
translate=true

[org/gnome/desktop/app-folders/folders/system-tools]
apps=['qvidcap.desktop', 'qv4l2.desktop', 'bssh.desktop', 'bvnc.desktop', 'hp-uiscan.desktop', 'org.gnome.Glade.desktop', 'mntray.desktop']
categories=['System', 'Settings']
excluded-apps=['timeshift-gtk.desktop']
name='System Tools'
translate=true

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/manjaro-time/manjaro-time.xml'
show-desktop-icons=false

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/manjaro-time/manjaro-time.xml'

[org.gnome.settings-daemon.plugins.color]
night-light-enabled=true

[org.gnome.desktop.interface]
cursor-theme='xcursor-breeze'
document-font-name='Sans 11'
enable-animations=true
font-name='Noto Sans 11'
gtk-im-module='gtk-im-context-simple'
gtk-theme='Matcha-sea'
icon-theme='Papirus-Dark-Maia'
monospace-font-name='Hack 11'

[org.gnome.desktop.wm.preferences]
titlebar-uses-system-font=false
button-layout='appmenu:minimize,maximize,close'
focus-mode='click'

[org.gnome.desktop.peripherals.touchpad]
tap-to-click=true
click-method='areas'
two-finger-scrolling-enabled=true
tap-and-drag=true

[org.gnome.shell]
always-show-log-out=true
disable-extension-version-validation=true
favorite-apps=['firefox.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.gedit.desktop', 'gnome-terminal.desktop', 'pamac-manager.desktop', 'org.gnome.Screenshot.desktop', 'gnome-tweak-tool.desktop', 'calamares.desktop', 'manjaro-architect.desktop']
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'appindicatorsupport@rgcjonas.gmail.com', 'pamac-updates@manjaro.org']

[org.gnome.shell.extensions.user-theme]
name='Matcha-dark-sea'

[org.gnome.Terminal.Legacy.Profile]
background-color='rgb(69,70,73)'
use-theme-colors=false
use-system-font=false
font='Hack 11'
foreground-color='rgb(220,233,235)'
background-color='rgb(27,34,36)'
palette=['rgb(46,52,54)', 'rgb(204,0,0)', 'rgb(78,154,6)', 'rgb(196,160,0)', 'rgb(52,101,164)', 'rgb(117,80,123)', 'rgb(6,152,154)', 'rgb(211,215,207)', 'rgb(85,87,83)', 'rgb(239,41,41)', 'rgb(138,226,52)', 'rgb(252,233,79)', 'rgb(114,159,207)', 'rgb(173,127,168)', 'rgb(52,226,226)', 'rgb(238,238,236)']
rewrap-on-resize=true
visible-name='manjaro'

[org.gnome.nautilus.icon-view]
default-zoom-level='small'

[org.gnome.nautilus.preferences]
thumbnail-limit=1000
show-create-link=true

[org.gnome.gedit.preferences.editor]
auto-indent=true
editor-font='Hack 12'
scheme='solarized-dark'
tabs-size=4
use-default-font=false

[org.gnome.settings-daemon.plugins.xsettings]
antialiasing='rgba'

[org.gnome.login-screen]
logo='/usr/share/icons/manjaro/maia/logo_text_white.png '

[org.gtk.Settings.FileChooser]
sort-directories-first=true

[org/gnome/shell/extensions/nightthemeswitcher]
commands-enabled=false
cursor-variant-original='xcursor-breeze'
gtk-variant-day='Matcha-sea'
gtk-variant-night='Matcha-dark-sea'
gtk-variant-original='Matcha-dark-sea'
icon-variant-original='Papirus-Dark-Maia'
manual-gtk-variants=true
manual-shell-variants=true
shell-variant-day='Matcha-dark-sea'
shell-variant-night='Matcha-dark-sea'
shell-variant-original='Matcha-dark-sea'
time-source='nightlight'

[org/gnome/shell/extensions/pop-shell]
gap-inner=uint32 0
gap-outer=uint32 0
show-title=true
tile-by-default=true
hint-color-rgba='rgb(0,135,135)'

[org/gnome/shell/extensions/materialshell/layouts]
float=false
split=false
half=true
default-layout='half'
windows-excluded='Enpass,Gnome-layout-switcher'
ratio-value=0.54999999999999993

[org/gnome/shell/extensions/materialshell/theme]
clock-horizontal=true
primary-color='#2eb398'
taskbar-item-style='name'
