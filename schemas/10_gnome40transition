[org.gnome.shell]
enabled-extensions=['pamac-updates@manjaro.org', 'nightthemeswitcher@romainvigier.fr', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'dash-to-dock@micxgx.gmail.com', 'gnome-ui-tune@itstime.tech']

[org/gnome/shell/extensions/nightthemeswitcher]
cursor-variant-original='xcursor-breeze'
gtk-variant-day='Adwaita-maia-compact'
gtk-variant-night='Adwaita-maia-compact-dark'
gtk-variant-original='Adwaita-maia-compact-dark'
icon-variant-original='Papirus-Dark-Maia'
manual-gtk-variants=true
manual-shell-variants=true
shell-variant-day='Adwaita-maia'
shell-variant-night='Adwaita-maia-dark'
shell-variant-original='Adwaita-maia-dark'
time-source='nightlight'

[org/gnome/desktop/wm/keybindings]
close=['<Super>q']
maximize=@as []
minimize=@as []
move-to-workspace-1=['<Shift><Super>1']
move-to-workspace-2=['<Shift><Super>2']
move-to-workspace-3=['<Shift><Super>3']
move-to-workspace-4=['<Shift><Super>4']
move-to-workspace-5=['<Shift><Super>5']
move-to-workspace-6=['<Shift><Super>6']
move-to-workspace-7=['<Shift><Super>7']
move-to-workspace-8=['<Shift><Super>8']
move-to-workspace-9=['<Shift><Super>9']
move-to-workspace-0=['<Shift><Super>0']
move-to-workspace-left=['<Super><Shift>Page_Up', '<Super><Shift>a', '<Super><Shift><Alt>Left', '<Control><Shift><Alt>Left']
move-to-workspace-right=['<Super><Shift>Page_Down', '<Super><Shift>d', '<Super><Shift><Alt>Right', '<Control><Shift><Alt>Right']
panel-main-menu=['<Alt>F1']
switch-to-workspace-1=['<Super>1']
switch-to-workspace-2=['<Super>2']
switch-to-workspace-3=['<Super>3']
switch-to-workspace-4=['<Super>4']
switch-to-workspace-5=['<Super>5']
switch-to-workspace-6=['<Super>6']
switch-to-workspace-7=['<Super>7']
switch-to-workspace-8=['<Super>8']
switch-to-workspace-9=['<Super>9']
switch-to-workspace-0=['<Super>0']
switch-to-workspace-left=['<Super>Page_Up', '<Super><Alt>Left', '<Control><Alt>Left', '<Super>a']
switch-to-workspace-right=['<Super>Page_Down', '<Super>d', '<Super><Alt>Right', '<Control><Alt>Right']

[org/gnome/shell/extensions/vertical-overview]
dash-max-height=100
hide-dash=false
override-dash=false

[org/gnome/shell/extensions/nightthemeswitcher/time]
manual-time-source=true
nightthemeswitcher-ondemand-keybinding=['<Shift><Super>t']
ondemand-time='night'
time-source='ondemand'

[org/gnome/shell/extensions/nightthemeswitcher]
commands-enabled=false
gtk-variant-day='Adwaita-maia-compact'
gtk-variant-night='Adwaita-maia-compact-dark'
manual-gtk-variants=false
manual-shell-variants=true
manual-time-source=true
ondemand-time='night'
settings-version=1
shell-variant-day='Adwaita-maia-compact'
shell-variant-night='Adwaita-maia-compact-dark'
time-source='ondemand'

[org/gnome/shell/extensions/nightthemeswitcher/commands]
enabled=false
sunrise='sed -i 's/Adwaita-maia-dark.conf/Adwaita-maia.conf/' ~/.config/qt5ct/qt5ct.conf'
sunset='sed -i 's/Adwaita-maia.conf/Adwaita-maia-dark.conf/' ~/.config/qt5ct/qt5ct.conf'

[org/gnome/shell/extensions/nightthemeswitcher/gtk-variants]
day='Adwaita-maia-compact'
manual=true
night='Adwaita-maia-compact-dark'

[org/gnome/shell/extensions/nightthemeswitcher/shell-variants]
day='Adwaita-maia-compact'
manual=true
night='Adwaita-maia-compact-dark'
